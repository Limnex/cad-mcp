{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAD MCP user configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "drawings_dir": {
      "type": "string",
      "minLength": 1
    },
    "log_dir": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["dxf", "acad"]
    }
  }
}
